/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Filenames here are stable (01.jpg, 02.jpg ...) and their contents can change,
# so deliberately NOT immutable — a long TTL on a re-used filename means any bad
# response gets pinned at the edge for its whole lifetime.
/img/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/sitemap.xml
  Content-Type: application/xml; charset=utf-8
  Cache-Control: public, max-age=3600

/robots.txt
  Cache-Control: public, max-age=3600
